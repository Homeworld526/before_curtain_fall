  m_GameObject: {fileID: 1518374154}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a63313e2eb5154c49806ba95dd59c50b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterUIParent: {fileID: 870355353}
  characterUIRootName: "\u4EBA\u7269UI"
  decorationParentPrefix: "\u597D\u611F\u8FDB\u5EA6\u6761-"
  characterDescriptions:
  - characterName: "\u5F20\u6D77\u5FC3"
    description: "\u5E74\u9F84:17\u5C81\r\n\u8EAB\u9AD8:161cm\r\n\u804C\u4E1A:\u4E50\u624B/\u81EA\u7531\u4F5C\u66F2\u4EBA\r\n\xB7\u81EA\u7531\u6563\u6F2B\u7684\u4E50\u961F\u4EBA\uFF0C\u59DC\u97F6\u5E73\u521D\u6B21\u5408\u4F5C\u7684\u4F19\u4F34\u3002\n\xB7\u5927\u90E8\u5206\u65F6\u95F4\u6001\u5EA6\u51B7\u6DE1\uFF0C\u4E0D\u592A\u4F1A\u8BB2\u6F02\u4EAE\u7684\u8BDD\uFF0C\u9762\u5BF9\u6210\u719F\u6E29\u67D4\u7684\u4EBA\u4F1A\u8868\u73B0\u51FA\u522B\u626D\u7684\u4E00\u9762\u3002"
  - characterName: "\u9648\u7389\u6811"
    description: "\u5E74\u9F84:42\u5C81\r\n\u8EAB\u9AD8:169cm\r\n\u804C\u4E1A:\u5546\u4EBA\r\n\xB7\u5F71\u89C6\u5A31\u4E50\u754C\u7684\u5927\u62FF\uFF0C\u59DC\u97F6\u5E73\u5E74\u5C11\u65F6\u671F\u7684\u5076\u50CF\u3002\r\n\xB7\u96F7\u5389\u98CE\u884C\uFF0C\u624B\u6BB5\u72E0\u8FA3\uFF0C\u5728\u4E1A\u754C\u98CE\u8BC4\u6BC1\u8A89\u53C2\u534A\u3002\r\n\xB7\u4E1A\u5185\u6D41\u4F20\u7740\u8BB8\u591A\u5173\u4E8E\u5979\u7684\u8D1F\u9762\u4F20\u95FB\u3002"
  - characterName: "\u590F\u4F26"
    description: "\u5E74\u9F84:23\u5C81\r\n\u8EAB\u9AD8:172cm\r\n\u804C\u4E1A:\u6F14\u5458\r\n\xB7\u5F53\u4E0B\u6F14\u827A\u754C\u6700\u53D7\u8FFD\u6367\u7684\u5F52\u56FD\u65B0\u661F\uFF0C\u59DC\u97F6\u5E73\u5B66\u751F\u65F6\u4EE3\u552F\u4E00\u7684\u53CB\u4EBA\u3002\r\n\xB7\u81EA\u4FE1\u4ECE\u5BB9\uFF0C\u4E3E\u6B62\u4F18\u96C5\uFF0C\u6C38\u8FDC\u80FD\u6E38\u5203\u6709\u4F59\u5730\u6EE1\u8DB3\u5916\u754C\u7684\u6240\u6709\u671F\u8BB8\u3002"
  - characterName: "\u59DC\u97F6\u5E73"
    description: "\u5E74\u9F84:24\u5C81\r\n\u8EAB\u9AD8:164cm\r\n\u804C\u4E1A:\u5267\u4F5C\u5BB6\r\n\xB7\u521D\u51FA\u8305\u5E90\u7684\u5267\u4F5C\u5BB6\uFF0C\u5BF9\u81EA\u5DF1\u70ED\u7231\u7684\u4E8B\u7269\u4F1A\u6295\u5165\u767E\u5206\u767E\u7684\u5FC3\u8840\u4E0E\u52AA\u529B\u3002\r\n\xB7\u81EA\u5E7C\u5728\u4FEE\u9053\u9662\u91CC\u957F\u5927\uFF0C\u6BCF\u5F53\u88AB\u63D0\u8D77\u201C\u5BB6\u4EBA\u201D\u7684\u8BDD\u9898\u65F6\uFF0C\u603B\u4F1A\u6D41\u9732\u4E9B\u8BB8\u590D\u6742\u7684\u795E\u60C5\u3002\r\n\xB7\u521A\u4ECE\u4EBA\u751F\u5DC5\u5CF0\u8DCC\u843D\u8C37\u5E95\uFF0C\u80FD\u518D\u9760\u81EA\u5DF1\u632F\u4F5C\u8D77\u6765\u5417\u2026\u2026\uFF1F"
  decorationConfigs: []
